# Copy to backend/.env values or export in your shell. All optional; defaults are safe.
APP_ENV=development
FRONTEND_URL=http://localhost:5173
MAX_UPLOAD_SIZE_MB=10
DATABASE_PATH=backend/data/mangocare.db
MANGO_MODEL_PATH=backend/models/AA-ENet_proposed.pt
VALIDATOR_MODEL_ID=openai/clip-vit-base-patch32
# Conservative defaults, NOT scientifically calibrated
CONFIDENCE_THRESHOLD=0.90
MARGIN_THRESHOLD=0.30
VALIDATION_THRESHOLD=0.50
